{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "_comment": [
    "Nothing with a chart default is `required`, at any level.",
    "`helm upgrade --reuse-values` renders against the PREVIOUS release's computed",
    "values, which cannot contain a key this version introduced — so a newly required",
    "key fails every in-place upgrade, on the one release that adds it. Requiring a",
    "defaulted key buys nothing anyway: the default always supplies it. `dsn` and",
    "`ownerDsn` are the only required values, conditionally, because they have no",
    "usable default and the install is broken without them."
  ],
  "type": "object",
  "properties": {
    "postgres": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["managed", "existing"]},
        "schema": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
        "poolSize": {"type": "integer", "minimum": 1},
        "dsn": {"type": "string"},
        "ownerDsn": {"type": "string"}
      },
      "allOf": [{
        "if": {"properties": {"mode": {"const": "existing"}}, "required": ["mode"]},
        "then": {
          "properties": {"dsn": {"minLength": 1}, "ownerDsn": {"minLength": 1}},
          "required": ["dsn", "ownerDsn"]
        }
      }]
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["none", "jwt"]},
        "fixedTenantId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
        },
        "jwt": {
          "type": "object",
          "properties": {
            "issuer": {"type": "string"},
            "audience": {"type": "string", "minLength": 1},
            "existingSecret": {"type": "string"}
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"mode": {"const": "jwt"}}, "required": ["mode"]},
        "then": {
          "properties": {"jwt": {
            "properties": {"issuer": {"minLength": 1}, "existingSecret": {"minLength": 1}},
            "required": ["issuer", "existingSecret"]
          }},
          "required": ["jwt"]
        }
      }]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer"},
        "nodePort": {"type": ["integer", "null"]}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1},
    "resources": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"}
  }
}
