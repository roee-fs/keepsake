  {
    "name": "legacy tools/list",
    "headers": {
      "content-type": "application/json",
      "accept": "application/json, text/event-stream",
      "mcp-protocol-version": "2025-11-25"
    },
    "request": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "tools/list"
    },
    "result": {
      "tools": [
        {
          "description": "List the concepts stored here, with a count of each type. Pass `prefix` to scope to one part of the tree (`detect/` lists everything beneath `detect`); omit it to see everything. This is the cheapest way to learn the shape of the knowledge base before searching it.",
          "inputSchema": {
            "properties": {
              "prefix": {
                "type": "string"
              }
            },
            "required": [],
            "type": "object",
            "additionalProperties": false
          },
          "name": "keepsake_list"
        },
        {
          "description": "Find concepts by keyword, ranked by relevance. Returns cards — path, type, title, description, score, status, stale, trust, generated_at — and never a body; read a promising path with keepsake_read.\n\n`status` is draft, stable or deprecated. `stale` is true once the concept's stale_after date has passed. `trust` is unverified, machine-confirmed or human-reviewed. `generated_at` is when the content last changed, or empty.\n\nMatching is lexical, not semantic: the index holds the words that were actually written, so distinctive keywords ('dormant', 'PKCE', 'indextime') find far more than a natural-language question does. Terms are OR-ed, so every extra term broadens the result instead of narrowing it: add terms to cast wider, drop them to focus. `limit` is required — ask for the fewest results you can use. `prefix` confines the search to one part of the tree.",
          "inputSchema": {
            "properties": {
              "query": {
                "type": "string"
              },
              "limit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              },
              "prefix": {
                "type": "string"
              }
            },
            "required": [
              "query",
              "limit"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "name": "keepsake_search",
          "outputSchema": {
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "score": {
                      "type": "number"
                    },
                    "status": {
                      "type": "string"
                    },
                    "stale": {
                      "type": "boolean"
                    },
                    "trust": {
                      "type": "string",
                      "enum": [
                        "unverified",
                        "machine-confirmed",
                        "human-reviewed"
                      ]
                    },
                    "generated_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "type",
                    "title",
                    "description",
                    "score",
                    "status",
                    "stale",
                    "trust",
                    "generated_at"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "results"
            ],
            "type": "object",
            "additionalProperties": false
          }
        },
        {
          "description": "Search concept text with a POSIX regular expression, case-insensitively. Returns each matching path with a short snippet around the match. Use it when you know the exact string or shape you want — an identifier, a config key, a URL — and keepsake_search's word matching is too loose. `limit` is required.",
          "inputSchema": {
            "properties": {
              "pattern": {
                "type": "string"
              },
              "limit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              }
            },
            "required": [
              "pattern",
              "limit"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "name": "keepsake_grep",
          "outputSchema": {
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "snippet": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "snippet"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "results"
            ],
            "type": "object",
            "additionalProperties": false
          }
        },
        {
          "description": "Read one concept in full: body, frontmatter, the concepts it links to, and the concepts that link back to it, with the same status, stale, trust and generated_at as keepsake_search. Returns null if nothing is stored at that path. Take paths from keepsake_list, keepsake_search or keepsake_grep.",
          "inputSchema": {
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "name": "keepsake_read"
        },
        {
          "description": "Store a new concept. `path` is relative and carries no `.md` suffix (`detect/dormant-rules`). `type` is required and says what kind of thing this is — Concept, Runbook, Decision. Fails if the path is taken; change an existing concept with keepsake_update.\n\nLinks are read out of `body`, never declared separately, so relate a concept by linking to it inline: `[dormant rules](/detect/dormant-rules.md)`.",
          "inputSchema": {
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "frontmatter": {
                "type": "object"
              }
            },
            "required": [
              "path",
              "type"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "name": "keepsake_create"
        },
        {
          "description": "Change an existing concept. Fields you leave out keep the values they have. Pass `expected_version` (from keepsake_read) to make the write a compare-and-swap: if anything has been written since, nothing changes and you get back the current version and body to merge against. Leave it out only when overwriting whatever is there is acceptable.",
          "inputSchema": {
            "properties": {
              "path": {
                "type": "string"
              },
              "expected_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "type": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "frontmatter": {
                "type": "object"
              }
            },
            "required": [
              "path"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "name": "keepsake_update"
        },
        {
          "description": "Record that one concept relates to another by appending a link from `from_path` to `to_path`. The edge then shows up as an outbound link on the source and as a backlink on the target.",
          "inputSchema": {
            "properties": {
              "from_path": {
                "type": "string"
              },
              "to_path": {
                "type": "string"
              }
            },
            "required": [
              "from_path",
              "to_path"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "name": "keepsake_relate"
        }
      ]
    }
  },
