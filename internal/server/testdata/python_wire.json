  {
    "name": "legacy initialize",
    "headers": {
      "content-type": "application/json",
      "accept": "application/json, text/event-stream"
    },
    "request": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "initialize",
      "params": {
        "protocolVersion": "2025-11-25",
        "capabilities": {},
        "clientInfo": {
          "name": "t",
          "version": "1"
        }
      }
    },
    "result": {
      "capabilities": {
        "experimental": {},
        "tools": {
          "listChanged": false
        }
      },
      "instructions": "You have a persistent memory through the okf_* tools. It holds what has been recorded before: facts, decisions, history, preferences and past conversations. Before answering anything that may depend on it, search it with a few distinctive keywords, read the most relevant results, and follow links and backlinks until the answer is grounded. When two memories disagree, prefer the more specific or more recent one, and say so. If the memory does not hold the answer, say so rather than guess. Before creating a concept, search for an existing one and update it instead if it exists. Name the paths you relied on.",
      "protocolVersion": "2025-11-25",
      "serverInfo": {
        "name": "keepsake",
        "version": ""
      }
    }
  },
